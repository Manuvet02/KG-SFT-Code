@prefix ex: <http://localhost:7200/repositories/KG-SFT/.well-known/sparql-examples/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix spex: <https://purl.expasy.org/sparql-examples/ontology#> .

#################################################################
# SPARQL query examples for the KG-SFT endpoint
# Source: Competency Questions (CQ1-CQ17) written and validated
# by Manuel & Lorenzo directly against GraphDB (localhost:7200).
# Format follows sib-swiss/sparql-examples, loadable via
# sparql_llm.SparqlExamplesLoader.
#
# NOTE on CQ11 and CQ12: kept as originally validated, but the
# subquery in each does not fully bind the outer variable it is
# meant to constrain (see discussion) - flagged with rdfs:comment
# so this is visible to anyone reading/reusing the examples.
#################################################################

_:sparql_examples_prefixes
    sh:declare
        [ sh:prefix "sft" ; sh:namespace "http://www.semanticweb.org/KG-SFT#" ] .

### CQ1

ex:cq01
    a sh:SPARQLExecutable, sh:SPARQLSelectExecutable ;
    rdfs:comment "Where are the main sports facilities located in Trentino?"@en ;
    sh:prefixes _:sparql_examples_prefixes ;
    sh:select """PREFIX sft: <http://www.semanticweb.org/KG-SFT#>

SELECT
	(REPLACE(STR(?sport_facility), "http://localhost:8080/source/SportFacility/","") AS ?id)
	?city ?address
WHERE {
   ?sport_facility a sft:sport_facility ;
 	sft:has_city ?city ;
  	sft:has_address ?address .
}""" ;
    schema:keywords "sport facility, location, city, address" ;
    schema:target <http://localhost:7200/repositories/KG-SFT> .

### CQ2

ex:cq02
    a sh:SPARQLExecutable, sh:SPARQLSelectExecutable ;
    rdfs:comment "What sports can be practiced at each sports facility?"@en ;
    sh:prefixes _:sparql_examples_prefixes ;
    sh:select """PREFIX sft: <http://www.semanticweb.org/KG-SFT#>

SELECT
	(REPLACE(STR(?sport_facility), "http://localhost:8080/source/SportFacility/","") AS ?id)
	(REPLACE(STR(?sport), "http://localhost:8080/source/Sport/","") AS ?sport_name)
WHERE {
   ?sport_facility a sft:sport_facility ;
  	sft:has_sport ?sport .
}""" ;
    schema:keywords "sport facility, sport, relation" ;
    schema:target <http://localhost:7200/repositories/KG-SFT> .

