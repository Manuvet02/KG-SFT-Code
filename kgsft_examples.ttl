	?timetable
WHERE {
   ?sport_facility a sft:sport_facility ;
  	sft:has_timetable ?timetable .
}""" ;
    schema:keywords "sport facility, timetable, opening hours" ;
    schema:target <http://localhost:7200/repositories/KG-SFT> .
