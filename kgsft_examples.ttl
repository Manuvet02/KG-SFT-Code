### CQ14

ex:cq14
    a sh:SPARQLExecutable, sh:SPARQLSelectExecutable ;
    rdfs:comment "How can I travel from my town to a ski resort using public transportation?"@en ;
    sh:prefixes _:sparql_examples_prefixes ;
    sh:select """PREFIX sft: <http://www.semanticweb.org/KG-SFT#>

SELECT
	(REPLACE(STR(?sport_facility), "http://localhost:8080/source/SportFacility/","") AS ?id)
	?code
WHERE {
   ?sport_facility a sft:sport_facility ;
  	sft:has_sport <http://localhost:8080/source/Sport/sci> ;
	sft:has_meanOfTransport ?mean_of_transport .

   ?mean_of_transport  a sft:mean_of_transport ;
   	sft:has_code ?code .
}""" ;
    schema:keywords "sport facility, ski, sci, transport, code" ;
    schema:target <http://localhost:7200/repositories/KG-SFT> .

### CQ15

ex:cq15
    a sh:SPARQLExecutable, sh:SPARQLSelectExecutable ;
    rdfs:comment "Which sports venues are accessible by bike or on foot?"@en ;
    sh:prefixes _:sparql_examples_prefixes ;
    sh:select """PREFIX sft: <http://www.semanticweb.org/KG-SFT#>

SELECT
	(REPLACE(STR(?path), "http://localhost:8080/source/Path/","") AS ?id)
	?description
WHERE {
   ?path sft:has_type "a raso" ;
   	sft:has_description ?description .
}""" ;
    schema:keywords "path, bike, foot, description, type" ;
    schema:target <http://localhost:7200/repositories/KG-SFT> .

### CQ16
# NOTE: uses predicate has_walkby (no underscore). Cross-check against
# has_walk_by used elsewhere for the same concept - likely the same
# property with an inconsistent name, needs to be resolved to a single
# canonical spelling before building the final VoID/ontology.

ex:cq16
    a sh:SPARQLExecutable, sh:SPARQLSelectExecutable ;
    rdfs:comment "Are there any sports facilities that are difficult to access due to limited transportation? (NOTE: check has_walkby vs has_walk_by spelling)"@en ;
    sh:prefixes _:sparql_examples_prefixes ;
    sh:select """PREFIX sft: <http://www.semanticweb.org/KG-SFT#>

SELECT
	(REPLACE(STR(?sport_facility), "http://localhost:8080/source/SportFacility/","") AS ?id)
WHERE {
   ?sport_facility a sft:sport_facility ;
  	sft:has_walkby 0 .
}""" ;
    schema:keywords "sport facility, walkby, transport, accessibility" ;
    schema:target <http://localhost:7200/repositories/KG-SFT> .

