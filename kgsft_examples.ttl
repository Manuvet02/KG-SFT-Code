### CQ5

ex:cq05
    a sh:SPARQLExecutable, sh:SPARQLSelectExecutable ;
    rdfs:comment "Which sports facilities regularly host a specific team or association?"@en ;
    sh:prefixes _:sparql_examples_prefixes ;
    sh:select """PREFIX sft: <http://www.semanticweb.org/KG-SFT#>

SELECT
	(REPLACE(STR(?sport_facility), "http://localhost:8080/source/SportFacility/","") AS ?id)
	(REPLACE(STR(?association), "http://localhost:8080/source/Association/","") AS ?team)
WHERE {
   ?association a sft:association ;
     	sft:has_sport ?sport .

   {
    	SELECT ?sport (MIN(?sport_facility) AS ?sport_facility)
    	WHERE {
      	   ?sport_facility a sft:sport_facility ;
         	sft:has_sport ?sport .
    	}
    	GROUP BY ?sport
   }
}""" ;
    schema:keywords "sport facility, association, team, sport" ;
    schema:target <http://localhost:7200/repositories/KG-SFT> .

### CQ6

ex:cq06
    a sh:SPARQLExecutable, sh:SPARQLSelectExecutable ;
    rdfs:comment "Which sports facilities require reservations?"@en ;
    sh:prefixes _:sparql_examples_prefixes ;
    sh:select """PREFIX sft: <http://www.semanticweb.org/KG-SFT#>

SELECT
	(REPLACE(STR(?sport_facility), "http://localhost:8080/source/SportFacility/","") AS ?id)
WHERE {
   ?sport_facility a sft:sport_facility ;
  	sft:has_service ?service .

   FILTER (?service IN (
  	<http://localhost:8080/source/Service/3>,
  	<http://localhost:8080/source/Service/4>,
  	<http://localhost:8080/source/Service/5>
   ))
}""" ;
    schema:keywords "sport facility, service, reservation, filter" ;
    schema:target <http://localhost:7200/repositories/KG-SFT> .

