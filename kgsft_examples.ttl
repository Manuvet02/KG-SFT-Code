### CQ8

ex:cq08
    a sh:SPARQLExecutable, sh:SPARQLSelectExecutable ;
    rdfs:comment "What additional services does a sports facility offer?"@en ;
    sh:prefixes _:sparql_examples_prefixes ;
    sh:select """PREFIX sft: <http://www.semanticweb.org/KG-SFT#>

SELECT
	(REPLACE(STR(?sport_facility), "http://localhost:8080/source/SportFacility/","") AS ?id)
	?name
WHERE {
   ?sport_facility a sft:sport_facility ;
    	sft:has_service ?service .

   ?service a sft:service ;
   	sft:has_name ?name .
}""" ;
    schema:keywords "sport facility, service, additional service" ;
    schema:target <http://localhost:7200/repositories/KG-SFT> .

### CQ9

ex:cq09
    a sh:SPARQLExecutable, sh:SPARQLSelectExecutable ;
    rdfs:comment "Which public transport options are available to reach a specific sports facility?"@en ;
    sh:prefixes _:sparql_examples_prefixes ;
    sh:select """PREFIX sft: <http://www.semanticweb.org/KG-SFT#>

SELECT
	(REPLACE(STR(?sport_facility), "http://localhost:8080/source/SportFacility/","") AS ?id)
	?code
WHERE {
   ?sport_facility a sft:sport_facility ;
    	sft:has_meanOfTransport ?mean_of_transport .

   ?mean_of_transport  a sft:mean_of_transport ;
   	sft:has_code ?code .
}""" ;
    schema:keywords "sport facility, transport, mean of transport, code" ;
    schema:target <http://localhost:7200/repositories/KG-SFT> .

### CQ10

ex:cq10
    a sh:SPARQLExecutable, sh:SPARQLSelectExecutable ;
    rdfs:comment "What is the closest public transport stop to a sports facility?"@en ;
    sh:prefixes _:sparql_examples_prefixes ;
    sh:select """PREFIX sft: <http://www.semanticweb.org/KG-SFT#>

SELECT
	(REPLACE(STR(?sport_facility), "http://localhost:8080/source/SportFacility/","") AS ?id)
	(REPLACE(STR(?stop), "http://localhost:8080/source/Stop/","") AS ?stop_id)
WHERE {
   ?sport_facility a sft:sport_facility ;
  	sft:has_stop ?stop .
}""" ;
    schema:keywords "sport facility, stop, transport, proximity" ;
    schema:target <http://localhost:7200/repositories/KG-SFT> .

### CQ11
# NOTE: the subquery groups ?route by ?mean_of_transport but does not
# explicitly join that ?route back to the outer ?mean_of_transport /

ex:cq11
    a sh:SPARQLExecutable, sh:SPARQLSelectExecutable ;
    rdfs:comment "What is the average travel time by public transport to a facility?"@en ;
    sh:prefixes _:sparql_examples_prefixes ;
    sh:select """PREFIX sft: <http://www.semanticweb.org/KG-SFT#>

SELECT
	(REPLACE(STR(?sport_facility), "http://localhost:8080/source/SportFacility/","") AS ?id)
	(AVG(?time) AS ?avg_time)
WHERE {
   ?sport_facility a sft:sport_facility ;
     	sft:has_meanOfTransport ?mean_of_transport .

   ?route a sft:route ;
     	sft:has_meanOfTransport ?mean_of_transport ;
     	sft:has_time ?time .
}
GROUP BY ?sport_facility""" ;
    schema:keywords "sport facility, route, travel time, transport, average" ;
    schema:target <http://localhost:7200/repositories/KG-SFT> .

### CQ12
# transport" and "bike-line paths" is not actually enforced - kept as
# validated, but likely returns a cartesian product. Double-check.

ex:cq12
    a sh:SPARQLExecutable, sh:SPARQLSelectExecutable ;
    rdfs:comment "Are there bike paths connecting a sports facility to the rest of the city?"@en ;
    sh:prefixes _:sparql_examples_prefixes ;
    sh:select """PREFIX sft: <http://www.semanticweb.org/KG-SFT#>

SELECT DISTINCT
	(REPLACE(STR(?sport_facility), "http://localhost:8080/source/SportFacility/","") AS ?idFacility)
	(REPLACE(STR(?path), "http://localhost:8080/source/Path/","") AS ?idPath)
WHERE {
   ?sport_facility a sft:sport_facility ;
     	sft:has_meanOfTransport ?mean_of_transport .

   ?route a sft:route ;
     	sft:has_meanOfTransport ?mean_of_transport .

   ?path a sft:path ;
     	sft:has_route ?route ;
     	sft:has_type "bike line" .
}""" ;
    schema:keywords "sport facility, path, bike line, route" ;
    schema:target <http://localhost:7200/repositories/KG-SFT> .

